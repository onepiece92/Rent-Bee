<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release/Profile (TestFlight + App Store) counterpart of
	     Runner.entitlements. Must be "production" or the distribution
	     provisioning profile will not match. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
