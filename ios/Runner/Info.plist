<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Rent Bee</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Rent Bee</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Contacts: flutter_native_contact_picker needs this or the app crashes
	     when picking a tenant's number. -->
	<key>NSContactsUsageDescription</key>
	<string>Rent Bee lets you pick a tenant's phone number from your contacts when adding or editing a unit.</string>
	<!-- Photo library / camera: the file picker (used for CSV import) links these
	     Apple APIs, so a purpose string is required even though Rent Bee only
	     imports document files. These prompts appear only if you pick a photo. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Rent Bee only needs access to your photos if you choose one when importing a data file.</string>
	<key>NSCameraUsageDescription</key>
	<string>Rent Bee only needs the camera if you choose to capture a document when importing a data file.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Rent Bee does not use your location; this entry is required only by a bundled system component.</string>
	<!-- url_launcher: allow calling / texting / emailing tenants. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>sms</string>
		<string>mailto</string>
		<string>https</string>
		<string>http</string>
	</array>
	<!-- Firebase phone auth REQUIRES this custom URL scheme to be registered, or
	     PhoneAuthProvider.verifyPhoneNumber calls fatalError() and the app hard
	     crashes (EXC_BREAKPOINT) the moment "Send code" is tapped. The scheme is
	     the GOOGLE_APP_ID with ":" replaced by "-", prefixed with "app-".
	     It is the redirect target for the reCAPTCHA verification web flow, which
	     is the fallback whenever silent-APNs app verification is unavailable.
	     See FirebaseAuth/Sources/Swift/AuthProvider/PhoneAuthProvider.swift. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>firebase-phone-auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-1-1005145227491-ios-2686f67bbe9afb0e8c85d6</string>
			</array>
		</dict>
	</array>
	<!-- Firebase phone auth uses a silent remote notification to verify the app. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Export compliance: app uses only standard HTTPS encryption, so this
	     skips the encryption prompt on every TestFlight/App Store upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
