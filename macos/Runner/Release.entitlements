<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Firebase phone-auth networking (Identity Toolkit + reCAPTCHA). -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- FirebaseAuth on macOS persists its session in the keychain and
	     requires Keychain Sharing even with no shared items; without it the
	     session is lost on relaunch and cloud sync silently runs local-only. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.brandbuilder.rentbee</string>
	</array>
</dict>
</plist>
